# --- Demo mode -------------------------------------------------------------
# When true (the default when Supabase vars are absent), the app runs a fully
# local, deterministic single-player session in memory: no Supabase and no
# Claude credentials required. Set to false for the full multiplayer stack.
NEXT_PUBLIC_DEMO_MODE=true

# --- Supabase (canonical game state, auth, realtime) -----------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by the quarter resolver and LLM gateway API routes.
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM (all roles: World Director, Chief of Staff, NPCs, characters) -----
# Default transport runs Claude Code sessions via the Claude Agent SDK using
# your Claude subscription OAuth token (not metered API billing).
# Generate with:  claude setup-token
LLM_TRANSPORT=claude-session        # claude-session | api | none
# Optional — can also be pasted in-app under Settings -> AI (the gear in the
# status bar). A token pasted there lives in that one server process and
# overrides this variable until it is disconnected or the process restarts, so
# it suits `pnpm dev` / `pnpm start` on one machine. On multi-instance
# serverless each instance starts empty: set the variable there.
CLAUDE_CODE_OAUTH_TOKEN=
# All in-game roles use Sonnet.
LLM_MODEL=sonnet

# Optional fallback transport (LLM_TRANSPORT=api): metered Anthropic API key.
# Also settable in-app: an sk-ant-api... key pasted under Settings -> AI
# switches that process to the metered `api` transport.
ANTHROPIC_API_KEY=

# Server secret for deriving opaque LLM conversation-session keys (HMAC).
# Any long random string; if unset, a per-process random secret is used
# (fine for demo; conversations reset on server restart).
LLM_KEY_SECRET=

# --- In-app AI setup on a public deployment --------------------------------
# Unlocks the Settings -> AI panel (Connect with Claude / paste a token) on a
# PUBLIC deployment that has no Supabase admin and is not a local connection.
# Set it to a long random string and share it only with whoever should be
# allowed to set the game's Claude credential. A visitor enters it once in the
# panel's "Unlock setup" field; the browser keeps it in sessionStorage and
# sends it as the `x-setup-secret` header on setup calls (constant-time
# checked, never logged, never returned). Leave unset to keep in-app setup
# closed on network deployments (env vars remain the only way in there).
LLM_SETUP_SECRET=

# NOTE ON SERVERLESS (e.g. Vercel): the default `claude-session` transport
# spawns the Claude Code CLI as a subprocess, which serverless functions cannot
# do. On such a host a subscription token connects but does not run — for LIVE
# AI on the hosted game, set LLM_TRANSPORT=api and an ANTHROPIC_API_KEY (or
# paste an sk-ant-api... key in the panel). The subscription path is for
# self-hosting on a normal Node process (`pnpm start`, a container, a VM).
