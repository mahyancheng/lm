# Frontier Capital — Raspberry Pi environment.
#
# Copy to `.env` beside this file and fill in LLM_KEY_SECRET. NAMES ONLY here:
# nothing in this repository ever carries a secret value. Codex uses its
# managed ChatGPT login stored in the dedicated persistent `codex-home` volume.
#
#   cp .env.example .env && chmod 600 .env
#
# The live file on the Pi is /home/ycmah/frontier-capital/.env (mode 0600) and
# already carries exactly these names.

NODE_ENV=production

# Supabase is not configured on this host, so demo mode is already on; this
# states it. Note that NEXT_PUBLIC_* variables are inlined by the bundler at
# build time — setting this at runtime documents the intent, it does not change
# a compiled client bundle.
NEXT_PUBLIC_DEMO_MODE=true

# Live AI through Codex app-server. This composes with demo mode:
# NEXT_PUBLIC_DEMO_MODE only gates Supabase. `CODEX_MODEL` is optional; leave
# it empty to let the managed account select an available model.
LLM_TRANSPORT=codex-app-server
CODEX_MODEL=
CODEX_HOME=/home/node/.codex
CODEX_WORKDIR=/home/node/.codex/workspace
# The durable game-to-Codex-thread map. Do not use the old .claude path.
CODEX_STATE_DIR=/home/node/.codex/frontier-capital

# How many Codex turns may run at once. This host is shared, so retain one;
# calls queue rather than being refused. Invalid values are read as 1.
LLM_MAX_CONCURRENCY=1

# How long, in total, one quarter's own batch of model calls (the World
# Director, then rival strategists in priority order) may run before the
# rivals still waiting fall back to their archetype policy instead. Read by
# the client, so it is inlined at BUILD time like every other NEXT_PUBLIC_*
# value here — changing it means rebuilding the image, not just editing this
# file and restarting. Tune only after observing the Pi under its own workload.
NEXT_PUBLIC_LLM_QUARTER_BUDGET_MS=90000

# How many rivals get a live strategist call in one quarter, at most — on top
# of, never above, the engine's own selection cap (`MAX_LIVE_STRATEGISTS` in
# @frontier/simulation, currently six: this only trims further). Four times
# raise it only with the quarter budget after observing this host.
NEXT_PUBLIC_LLM_STRATEGISTS_PER_QUARTER=4

# Cap the Next server's V8 heap so the headroom belongs to the agent
# app-server process rather than to a garbage collector that has not felt any
# pressure.
NODE_OPTIONS=--max-old-space-size=384

# After starting the container, open Settings → Connect ChatGPT in the app.
# Never put a ChatGPT token in this file.
# The optional fallback below is an explicit, metered Anthropic API choice;
# it is never selected from ambient credentials.
# LLM_TRANSPORT=api
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=

# Where server-side saves live, inside the `saves` volume (mounted at /data).
#
# UNSET MEANS OFF, and off is a complete, supported configuration: every browser
# keeps its saves in localStorage exactly as it always has. Setting this turns
# on the profile-keyed store, which is what lets a game started on the phone be
# continued on the laptop — the player picks a profile name and the laptop lists
# it. It is not an account system: no password, no email, nothing to reset.
#
# Caps, enforced by the server and stated in the README: 4 MB per save file,
# 4 slots per profile (autosave + 3), 32 profiles per host.
#
# The directory must be writable by `node` (uid 1000). See the comment on the
# `saves` volume in docker-compose.yml for the one-time command; until it is
# run, the app reports server saves as unavailable rather than failing writes.
SAVE_DIR=/data/saves

# Canonical Pi game command records. Uses the existing persistent /data volume.
# Pi defaults to /data/games through the compose volume. A standalone process
# without this configuration uses its explicit local demo adapter.
GAME_SESSION_DIR=/data/games

# HMAC key for deriving opaque game conversation keys. Long and random;
# changing it starts every Codex conversation thread afresh.
LLM_KEY_SECRET=
