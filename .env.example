# --- Demo mode -------------------------------------------------------------
# When true (the default when Supabase vars are absent), the app runs a fully
# local, deterministic single-player session in memory: no Supabase and no
# Claude credentials required. Set to false for the full multiplayer stack.
NEXT_PUBLIC_DEMO_MODE=true

# --- Supabase (canonical game state, auth, realtime) -----------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by the quarter resolver and LLM gateway API routes.
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM (all roles: World Director, Chief of Staff, NPCs, characters) -----
# Default: Codex app-server over stdio, authenticated by the supported Codex
# CLI ChatGPT login stored in CODEX_HOME. Do not put a ChatGPT token here.
LLM_TRANSPORT=codex-app-server      # codex-app-server | api | none; claude-session migrates to Codex
# Leave unset to let the logged-in Codex CLI choose an available model. If your
# deployment has an approved model name, set it explicitly here.
CODEX_MODEL=
# Persistent, dedicated Codex state. Must not point at an existing .claude dir.
CODEX_HOME=/var/lib/frontier-capital/codex-home
# Empty, dedicated read-only workspace for the app-server. Do not point this at
# the game repository or a host directory.
CODEX_WORKDIR=/var/lib/frontier-capital/codex-workspace
# Optional persistent map/metadata directory. On Pi compose use CODEX_STATE_DIR
# rather than an old LLM_STATE_DIR path under .claude.
CODEX_STATE_DIR=
# Pin the CLI package used by deployment images. Set a tested published version
# before building; verify it with `codex --version` after deployment.
CODEX_CLI_VERSION=

# `claude-session` is accepted only as a migration spelling for Codex; it never
# starts Claude or reads these values. `api` remains an explicit Anthropic API
# fallback and is never selected from ambient credentials.
CLAUDE_CODE_OAUTH_TOKEN=
LLM_MODEL=
ANTHROPIC_API_KEY=

# Server secret for deriving opaque LLM conversation-session keys (HMAC).
# Any long random string; if unset, a per-process random secret is used
# (fine for demo; conversations reset on server restart).
LLM_KEY_SECRET=

# --- In-app AI setup on a public deployment --------------------------------
# Legacy in-app Claude credential setup only. Codex uses the supported CLI
# ChatGPT device/browser login on the host; it has no paste-a-token flow.
LLM_SETUP_SECRET=

# Codex app-server is a long-lived local subprocess. Use an always-on Node
# host/container with a persistent CODEX_HOME; it is not a serverless backend.
