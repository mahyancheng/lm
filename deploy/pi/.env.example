# Frontier Capital — Raspberry Pi environment.
#
# Copy to `.env` beside this file and fill in LLM_KEY_SECRET. NAMES ONLY here:
# nothing in this repository ever carries a secret value, and the Claude
# credential is never an environment variable in this deployment at all — it
# is connected through Settings → AI and sealed to the volume under
# LLM_KEY_SECRET.
#
#   cp .env.example .env && chmod 600 .env
#
# The live file on the Pi is /home/ycmah/frontier-capital/.env (mode 0600) and
# already carries exactly these names.

NODE_ENV=production

# Supabase is not configured on this host, so demo mode is already on; this
# states it. Note that NEXT_PUBLIC_* variables are inlined by the bundler at
# build time — setting this at runtime documents the intent, it does not change
# a compiled client bundle.
NEXT_PUBLIC_DEMO_MODE=true

# Live AI through Claude Code sessions on the operator's subscription. This
# composes with demo mode: NEXT_PUBLIC_DEMO_MODE only gates Supabase.
LLM_TRANSPORT=claude-session
LLM_MODEL=sonnet

# How many model calls may run at once. Each one spawns a ~213 MB Claude Code
# subprocess, and this host has ~2.1 GB free and other tenants to keep alive, so
# the answer is one. Calls are QUEUED, never refused: a four-rival quarter still
# gets four genuine strategist plans, one after another. Anything that is not a
# whole number of at least one is read as 1.
LLM_MAX_CONCURRENCY=1

# Cap the Next server's V8 heap so the headroom belongs to the agent
# subprocess rather than to a garbage collector that has not felt any pressure.
# The Claude binary is Bun-compiled and ignores this, which is the intent.
NODE_OPTIONS=--max-old-space-size=384

# The Pi is reachable on the tailnet only, so everyone who can open the page is
# the household. `local` tells the credential gate to trust every connection:
# Settings → AI (and the start page's "Set up AI") go straight to Connect with
# Claude, with no unlock secret. Remove this line on any host the public can
# reach — then LLM_SETUP_SECRET below becomes the gate again.
LLM_TOKEN_SETUP=local

# Only read when LLM_TOKEN_SETUP is NOT `local`: the unlock secret a caller
# must present in `x-setup-secret` to write the Claude credential on a
# network-reachable host with no Supabase admin. Safe to leave empty here.
LLM_SETUP_SECRET=

# Where server-side saves live, inside the `saves` volume (mounted at /data).
#
# UNSET MEANS OFF, and off is a complete, supported configuration: every browser
# keeps its saves in localStorage exactly as it always has. Setting this turns
# on the profile-keyed store, which is what lets a game started on the phone be
# continued on the laptop — the player picks a profile name and the laptop lists
# it. It is not an account system: no password, no email, nothing to reset.
#
# Caps, enforced by the server and stated in the README: 4 MB per save file,
# 4 slots per profile (autosave + 3), 32 profiles per host.
#
# The directory must be writable by `node` (uid 1000). See the comment on the
# `saves` volume in docker-compose.yml for the one-time command; until it is
# run, the app reports server saves as unavailable rather than failing writes.
SAVE_DIR=/data/saves

# HMAC key for deriving conversation keys, so a Claude session id is never
# addressable by anything a client controls. Long and random; changing it starts
# every conversation thread afresh.
LLM_KEY_SECRET=
